# =============================================================
# Homelab — Pipe Edition · Variables de entorno
# Copiar este archivo a .env y rellenar con valores reales.
# NUNCA commitear el .env con valores reales al repositorio.
# =============================================================

# --- General --------------------------------------------------
TZ=America/Santiago
PUID=1000
PGID=1000
DOMINIO=tudominio.com          # Dominio principal (ej: pipe.cl)

# --- Tailscale ------------------------------------------------
TAILSCALE_AUTHKEY=              # tskey-auth-XXXXX (obtenido en tailscale.com/settings/keys)

# --- Nextcloud ------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CAMBIA_ESTO
NEXTCLOUD_DB_PASSWORD=CAMBIA_ESTO
NEXTCLOUD_TRUSTED_DOMAINS=cloud.${DOMINIO}

# --- Immich ---------------------------------------------------
IMMICH_DB_PASSWORD=CAMBIA_ESTO
IMMICH_DB_USERNAME=immich
IMMICH_DB_DATABASE_NAME=immich

# --- Vaultwarden ----------------------------------------------
VAULTWARDEN_ADMIN_TOKEN=        # Generar con: openssl rand -base64 48
VAULTWARDEN_DOMAIN=https://vault.${DOMINIO}

# --- Paperless-ngx --------------------------------------------
PAPERLESS_SECRET_KEY=           # Generar con: openssl rand -hex 32
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=CAMBIA_ESTO
PAPERLESS_DB_PASSWORD=CAMBIA_ESTO

# --- Jellyfin -------------------------------------------------
# Sin variables especiales requeridas en arranque

# --- Transmission ---------------------------------------------
TRANSMISSION_USER=pipe
TRANSMISSION_PASS=CAMBIA_ESTO

# --- Forgejo --------------------------------------------------
FORGEJO_DB_PASSWORD=CAMBIA_ESTO
FORGEJO_SECRET_KEY=             # Generar con: openssl rand -hex 32
FORGEJO_INTERNAL_TOKEN=         # Generar con: openssl rand -hex 32

# --- Woodpecker CI --------------------------------------------
WOODPECKER_SECRET=              # Generar con: openssl rand -hex 32
WOODPECKER_FORGEJO_CLIENT=      # OAuth App Client ID en Forgejo
WOODPECKER_FORGEJO_SECRET=      # OAuth App Secret en Forgejo
WOODPECKER_FORGEJO_URL=https://git.${DOMINIO}
WOODPECKER_SERVER_HOST=ci.${DOMINIO}

# --- BookStack ------------------------------------------------
BOOKSTACK_DB_PASSWORD=CAMBIA_ESTO
BOOKSTACK_APP_KEY=              # Generar con: php artisan key:generate --show
BOOKSTACK_APP_URL=https://wiki.${DOMINIO}

# --- Actual Budget --------------------------------------------
# Sin variables requeridas en arranque inicial

# --- n8n ------------------------------------------------------
N8N_ENCRYPTION_KEY=             # Generar con: openssl rand -hex 24
N8N_BASIC_AUTH_USER=pipe
N8N_BASIC_AUTH_PASSWORD=CAMBIA_ESTO

# --- Authelia -------------------------------------------------
AUTHELIA_JWT_SECRET=            # Generar con: openssl rand -hex 32
AUTHELIA_SESSION_SECRET=        # Generar con: openssl rand -hex 32
AUTHELIA_STORAGE_ENCRYPTION_KEY= # Generar con: openssl rand -hex 32
AUTHELIA_DOMAIN=${DOMINIO}

# --- Restic ---------------------------------------------------
RESTIC_REPOSITORY=              # Ej: /srv/backups o s3:... o b2:...
RESTIC_PASSWORD=                # Contraseña del repositorio cifrado
B2_ACCOUNT_ID=                  # Backblaze B2 (opcional)
B2_ACCOUNT_KEY=                 # Backblaze B2 (opcional)

# --- Nginx Proxy Manager --------------------------------------
# Credenciales iniciales por defecto: admin@example.com / changeme
# Cambiar en la UI en el primer login

# --- Ollama ---------------------------------------------------
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
