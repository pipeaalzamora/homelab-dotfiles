# =============================================================
# Homelab — Pipe Edition · Variables de entorno
# Copiar este archivo a .env y rellenar con valores reales.
# NUNCA commitear el .env con valores reales al repositorio.
# =============================================================

# --- General --------------------------------------------------
TZ=America/Santiago
PUID=1000
PGID=1000
LOCAL_DOMAIN=home              # Dominio interno sugerido: jellyfin.home, cloud.home, git.home

# --- Tailscale ------------------------------------------------
TAILSCALE_AUTHKEY=              # tskey-auth-XXXXX (obtenido en tailscale.com/settings/keys)

# --- Nextcloud ------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CAMBIA_ESTO
NEXTCLOUD_DB_ROOT_PASSWORD=CAMBIA_ESTO
NEXTCLOUD_DB_PASSWORD=CAMBIA_ESTO
NEXTCLOUD_TRUSTED_DOMAINS='cloud.home homelab-pipe'

# --- Jellyfin -------------------------------------------------
# Sin variables especiales requeridas en arranque

# --- qBittorrent ----------------------------------------------
# Credenciales iniciales según la imagen linuxserver/qbittorrent; cambiar en primer login.

# --- Forgejo --------------------------------------------------
FORGEJO_DB_PASSWORD=CAMBIA_ESTO
FORGEJO_SECRET_KEY=             # Generar con: openssl rand -hex 32
FORGEJO_INTERNAL_TOKEN=         # Generar con: openssl rand -hex 32

# --- BookStack ------------------------------------------------
BOOKSTACK_DB_PASSWORD=CAMBIA_ESTO
BOOKSTACK_APP_KEY=              # Generar con: php artisan key:generate --show
BOOKSTACK_APP_URL=http://wiki.home

# --- n8n ------------------------------------------------------
N8N_DB_PASSWORD=CAMBIA_ESTO
N8N_ENCRYPTION_KEY=             # Generar con: openssl rand -hex 24
N8N_BASIC_AUTH_USER=pipe
N8N_BASIC_AUTH_PASSWORD=CAMBIA_ESTO

# --- Restic ---------------------------------------------------
RESTIC_REPOSITORY=              # Ej: /srv/backups o s3:... o b2:...
RESTIC_PASSWORD=                # Contraseña del repositorio cifrado
B2_ACCOUNT_ID=                  # Backblaze B2 (opcional)
B2_ACCOUNT_KEY=                 # Backblaze B2 (opcional)

# --- Nginx Proxy Manager --------------------------------------
# Credenciales iniciales por defecto: admin@example.com / changeme
# Cambiar en la UI en el primer login
