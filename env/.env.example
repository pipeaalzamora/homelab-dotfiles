# =============================================================
# Homelab — Pipe Edition · Variables de entorno
# Copiar este archivo a .env y rellenar con valores reales.
# NUNCA commitear el .env con valores reales al repositorio.
# =============================================================

# --- General --------------------------------------------------
TZ=America/Santiago
PUID=1000
PGID=1000
HOMELAB_ROOT=/home/pipeaalzamora/homelab
# Dominio interno sugerido: jellyfin.home, cloud.home, git.home
LOCAL_DOMAIN=home
NPM_HTTP_PORT=8088
NPM_HTTPS_PORT=8443
NPM_ADMIN_PORT=8181
ADGUARD_DNS_PORT=1053
ADGUARD_SETUP_PORT=3000
ADGUARD_ADMIN_PORT=8080
HOMEPAGE_ALLOWED_HOSTS=localhost:3001,127.0.0.1:3001
ADGUARD_USERNAME=pipe
ADGUARD_PASSWORD=CAMBIA_ESTO

# --- Tailscale ------------------------------------------------
# tskey-auth-XXXXX (obtenido en tailscale.com/settings/keys)
TAILSCALE_AUTHKEY=

# --- Nextcloud ------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CAMBIA_ESTO
NEXTCLOUD_DB_ROOT_PASSWORD=CAMBIA_ESTO
NEXTCLOUD_DB_PASSWORD=CAMBIA_ESTO
NEXTCLOUD_TRUSTED_DOMAINS='cloud.home homelab-pipe'

# --- Jellyfin -------------------------------------------------
# Sin variables especiales requeridas en arranque

# --- qBittorrent ----------------------------------------------
# Credenciales iniciales según la imagen linuxserver/qbittorrent; cambiar en primer login.

# --- Forgejo --------------------------------------------------
FORGEJO_DB_PASSWORD=CAMBIA_ESTO
FORGEJO_DOMAIN=localhost
FORGEJO_ROOT_URL=http://localhost:3004/
FORGEJO_SSH_DOMAIN=localhost
# Generar con: openssl rand -hex 32
FORGEJO_SECRET_KEY=
# Generar con: openssl rand -hex 32
FORGEJO_INTERNAL_TOKEN=

# --- BookStack ------------------------------------------------
BOOKSTACK_DB_PASSWORD=CAMBIA_ESTO
# Generar con: php artisan key:generate --show
BOOKSTACK_APP_KEY=
BOOKSTACK_APP_URL=http://localhost:6875

# --- Infisical (gestión de secretos) --------------------------
INFISICAL_DB_PASSWORD=CAMBIA_ESTO
# Generar con: openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=
# Generar con: openssl rand -base64 32
INFISICAL_AUTH_SECRET=
INFISICAL_SITE_URL=http://localhost:8083
INFISICAL_TELEMETRY_ENABLED=false

# --- n8n ------------------------------------------------------
N8N_DB_PASSWORD=CAMBIA_ESTO
# Generar con: openssl rand -hex 24
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=pipe
N8N_BASIC_AUTH_PASSWORD=CAMBIA_ESTO

# --- Restic ---------------------------------------------------
# Ej local dentro del contenedor: local:/mnt/restic-repo
# Ej remoto: s3:... o b2:...
RESTIC_REPOSITORY=local:/mnt/restic-repo
# Contraseña del repositorio cifrado
RESTIC_PASSWORD=
# Backblaze B2 (opcional)
B2_ACCOUNT_ID=
# Backblaze B2 (opcional)
B2_ACCOUNT_KEY=

# --- Nginx Proxy Manager --------------------------------------
# Credenciales iniciales por defecto: admin@example.com / changeme
# Cambiar en la UI en el primer login

# --- qBittorrent local login -----------------------------------
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=CAMBIA_ESTO

# --- Facto ----------------------------------------------------
FACTO_DB_ROOT_PASSWORD=CAMBIA_ESTO
FACTO_DB_PASSWORD=CAMBIA_ESTO
# Generar con: openssl rand -hex 32
FACTO_SECRET=
FACTO_PORT=8086

# --- Piga -----------------------------------------------------
PIGA_DB_ROOT_PASSWORD=CAMBIA_ESTO
PIGA_DB_PASSWORD=CAMBIA_ESTO
# Generar con: openssl rand -hex 32
PIGA_SECRET=
PIGA_PORT=8087

# --- Docat ----------------------------------------------------
DOCAT_PORT=8089
DOCAT_MAX_UPLOAD_SIZE=100M

# --- EveryDocs -----------------------------------------------
EVERYDOCS_DB_ROOT_PASSWORD=CAMBIA_ESTO
EVERYDOCS_DB_PASSWORD=CAMBIA_ESTO
# Generar con: openssl rand -hex 64
EVERYDOCS_SECRET_KEY_BASE=
EVERYDOCS_IMAGE_TAG=1.5.0
EVERYDOCS_WEB_IMAGE_TAG=1.5.0
EVERYDOCS_WEB_PORT=8090
EVERYDOCS_CORE_PORT=8091

# --- DailyTxT -------------------------------------------------
# Revisar versión estable en https://github.com/PhiTux/DailyTxT/releases
DAILYTXT_IMAGE_TAG=2.6.2
# Generar con: openssl rand -base64 32
DAILYTXT_SECRET_TOKEN=
DAILYTXT_ADMIN_PASSWORD=CAMBIA_ESTO
DAILYTXT_ALLOW_REGISTRATION=true
DAILYTXT_LOGOUT_AFTER_DAYS=40
DAILYTXT_INDENT=4
DAILYTXT_PORT=8092

# --- Wastebin ------------------------------------------------
# Pastebin local. No exponer a internet sin SSO/rate-limit.
WASTEBIN_IMAGE_TAG=latest
WASTEBIN_PORT=8093
WASTEBIN_DATABASE_PATH=/data/state.db
WASTEBIN_BASE_URL=http://localhost:8093
WASTEBIN_PASSWORD_SALT=CAMBIA_ESTO
# Generar con: openssl rand -base64 64
WASTEBIN_SIGNING_KEY=
WASTEBIN_THEME=ayu
WASTEBIN_TITLE=Wastebin

# --- Iguana --------------------------------------------------
# La imagen se construye desde GitHub; puedes fijar un commit en vez de master.
IGUANA_GIT_REF=master
IGUANA_IMAGE_TAG=local
IGUANA_VARIANT=production
IGUANA_USE_NGINX=true
IGUANA_LANG=es-cl
IGUANA_PORT=8094

# --- Authelia -------------------------------------------------
# Generar cada uno con: openssl rand -hex 32
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_PORT=9091
