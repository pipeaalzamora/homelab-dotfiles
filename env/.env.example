# =============================================================================
# HOMELAB DOTFILES - VARIABLES DE ENTORNO
# =============================================================================
# Copiar este archivo a .env y personalizar los valores
# cp env/.env.example env/.env
# =============================================================================

# -----------------------------------------------------------------------------
# Configuració±±±n Base
# -----------------------------------------------------------------------------
# Ruta base del homelab (Linux/macOS: /srv/homelab, Windows: C:\homelab)
HOMELAB_ROOT=/srv/homelab

# IP local del servidor para acceso a servicios
LAN_IP=192.168.1.100

# Zona horaria
TZ=America/Santiago

# IDs de usuario/grupo para permisos (Linux/macOS)
# En Windows estos valores no se usan
PUID=1000
PGID=1000

# -----------------------------------------------------------------------------
# Puertos Secuenciales (3000-3016)
# -----------------------------------------------------------------------------
# Core
PORT_PORTAINER_API=3000
PORT_PORTAINER_UI=3001

# Media
PORT_JELLYFIN=3002
PORT_SONARR=3003
PORT_RADARR=3004
PORT_PROWLARR=3005
PORT_BAZARR=3006
PORT_TRANSMISSION=3007

# Productivity
PORT_EXCALIDRAW=3008
PORT_STIRLING_PDF=3009
PORT_APPFLOWY_HTTP=3015
PORT_APPFLOWY_HTTPS=3016

# Secrets
PORT_INFISICAL=3010

# Reading
PORT_BOOKORBIT=3011

# Design
PORT_PENPOT=3012

# Finance
PORT_SECURO_FRONTEND=3013
PORT_SECURO_BACKEND=3014

# -----------------------------------------------------------------------------
# Credenciales por Defecto (CAMBIAR EN PRODUCCIÓ± ±N)
# -----------------------------------------------------------------------------

# Transmission
TRANSMISSION_USER=admin
TRANSMISSION_PASS=admin

# AppFlowy
APPFLOWY_ADMIN_EMAIL=admin@homelab.local
APPFLOWY_ADMIN_PASSWORD=appflowy_admin_password_change_me

# BookOrbit
BOOKORBIT_ADMIN_EMAIL=admin@homelab.local
BOOKORBIT_ADMIN_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Secret Keys (GENERAR ALEATORIAS)
# -----------------------------------------------------------------------------
# Usar: openssl rand -hex 32

# Infisical
INFISICAL_ENCRYPTION_KEY=change_this_to_a_random_64_char_encryption_key

# Penpot
PENPOT_SECRET_KEY=change_this_to_a_random_64_char_secret_key_please

# Securo
SECURO_SECRET_KEY=change_this_to_a_random_64_char_secret_key_please

# -----------------------------------------------------------------------------
# Contraseñ±±±as de Bases de Datos (GENERAR ALEATORIAS)
# -----------------------------------------------------------------------------
# Usar: openssl rand -base64 24

# Infisical PostgreSQL
INFISICAL_POSTGRES_PASSWORD=infisical_password_change_me

# Penpot PostgreSQL
PENPOT_POSTGRES_PASSWORD=penpot_password_change_me

# Securo PostgreSQL
SECURO_POSTGRES_PASSWORD=securo_db_password_change_me

# AppFlowy PostgreSQL
APPFLOWY_POSTGRES_PASSWORD=appflowy_password_change_me

# -----------------------------------------------------------------------------
# Restic Backups (OPCIONAL - si decides reinstalar)
# -----------------------------------------------------------------------------
# Repositorio local: local:/mnt/restic-repo
# Repositorio remoto (ej. S3): s3:s3.amazonaws.com/bucket-name/path
RESTIC_REPOSITORY=local:/mnt/restic-repo
RESTIC_PASSWORD=restic_password_change_me

# -----------------------------------------------------------------------------
# Notas
# -----------------------------------------------------------------------------
# 1. Todas las contraseñ±±±as y secret keys deben ser cambiadas antes del primer uso
# 2. Generar contraseñ±±±as aleatorias con: openssl rand -base64 24
# 3. Generar secret keys con: openssl rand -hex 32
# 4. Mantener este archivo .env fuera del control de versiones (.gitignore)
