# Copia estas variables a .env (raiz del repo). No subas el .env real.
# Generar valores: openssl rand -hex 32

BASEROW_JWT_SECRET=

# Hash Argon2: docker run --rm -it vaultwarden/server /vaultwarden hash
# En .env cada $ del hash debe escribirse como $$
VAULTWARDEN_ADMIN_TOKEN=
# Pone false cuando hayas creado tu cuenta
VAULTWARDEN_SIGNUPS=true

TANDOOR_SECRET_KEY=
TANDOOR_DB_PASSWORD=

# Pendientes de migrar (stack productivity)
VIKUNJA_SECRET=
PENPOT_SECRET_KEY=
PENPOT_DB_PASSWORD=
